# Desactiva listado de directorios
Options -Indexes -MultiViews

RewriteEngine On

# Bloquear scripts de debug y migraciones web
RewriteRule ^(hash|test|test2)\.php$ - [F,L]
RewriteRule ^(migrations_v2|run_migration|migrate_incomes)\.php$ - [F,L]

# Responder correctamente las preflight OPTIONS (CORS)
RewriteCond %{REQUEST_METHOD} =OPTIONS
RewriteRule ^ - [R=204,L]

# Enruta todo a index.php si no es un archivo real
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Pasar Authorization a PHP (Bearer / JWT)
SetEnvIf Authorization .+ HTTP_AUTHORIZATION=$0

# CORS y caché
<IfModule mod_headers.c>
  Header set Cache-Control "max-age=0,no-store"
</IfModule>
